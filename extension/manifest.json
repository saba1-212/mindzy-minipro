
{
  "manifest_version": 3,

  "name": "Mindzy Focus Blocker",

  "version": "1.0",

  "description": "Blocks distracting websites during focus sessions.",

  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],

  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.twitter.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Mindzy Focus"
  }
}
